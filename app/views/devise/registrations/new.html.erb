<% content_for :title, "Sign Up" %>

<div class="max-w-md mx-auto px-4 py-16 font-sans">

  <!-- Heading -->
  <div class="text-center mb-8">
    <span class="text-[10px] font-extrabold text-[#5B5CE6] tracking-widest uppercase bg-blue-50 px-3 py-1 rounded-full">
      ✦ GET STARTED
    </span>
    <h1 class="text-3xl font-black text-gray-900 tracking-tight mt-3 mb-2">Create Your Account</h1>
    <p class="text-gray-500 text-xs sm:text-sm">Join us and start sharing your articles.</p>
  </div>

  <!-- Main Sign Up Card -->
  <div class="bg-white rounded-3xl p-8 md:p-10 shadow-xl border border-gray-100">

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-6" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Email Field -->
      <div class="space-y-2">
        <%= f.label :email, class: "block text-xs font-bold text-gray-700 uppercase tracking-wider" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", 
            class: "w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5B5CE6] focus:bg-white text-sm text-gray-900 transition", 
            placeholder: "Enter your email" %>
      </div>

      <!-- Password Field -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <%= f.label :password, class: "block text-xs font-bold text-gray-700 uppercase tracking-wider" %>
          <% if @minimum_password_length %>
            <span class="text-[10px] text-indigo-600 font-medium">Min <%= @minimum_password_length %> chars</span>
          <% end %>
        </div>
        <%= f.password_field :password, autocomplete: "new-password", 
            class: "w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5B5CE6] focus:bg-white text-sm text-gray-900 transition", 
            placeholder: "Create a password" %>
      </div>

      <!-- Confirm Password Field -->
      <div class="space-y-2">
        <%= f.label :password_confirmation, "Confirm Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", 
            class: "w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5B5CE6] focus:bg-white text-sm text-gray-900 transition", 
            placeholder: "Confirm your password" %>
      </div>

      <!-- Submit Button -->
      <div>
        <%= f.submit "Create Account", 
            class: "w-full bg-[#2952E3] hover:bg-blue-700 text-white font-bold py-3.5 rounded-xl transition shadow-md hover:shadow-lg text-xs uppercase tracking-wider cursor-pointer" %>
      </div>

    <% end %>

    <!-- Devise Shared Links Footer -->
    <div class="mt-8 pt-6 border-t border-gray-100 text-center text-xs text-gray-500 space-y-2">
      <%= render "devise/shared/links" %>
    </div>

<div class="max-w-md mx-auto px-4 py-6 font-sans">

  <!-- Back Link -->
  <div class="mb-6">
    <%= link_to "← Back to Home", root_path, class: "text-xs font-bold text-gray-500 hover:text-[#5B5CE6] transition" %>
  </div>

</div>
  </div>
  

</div>