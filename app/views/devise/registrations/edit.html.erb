<% content_for :title, "Edit Profile" %>

<div class="max-w-xl mx-auto px-4 py-16 font-sans">

  <!-- Heading -->
  <div class="text-center mb-8">
    <span class="text-[10px] font-extrabold text-[#5B5CE6] tracking-widest uppercase bg-blue-50 px-3 py-1 rounded-full">
      ✦ ACCOUNT SETTINGS
    </span>
    <h1 class="text-3xl font-black text-gray-900 tracking-tight mt-3 mb-2">Edit Your Profile</h1>
    <p class="text-gray-500 text-xs sm:text-sm">Manage your account settings and keep your information up to date.</p>
  </div>

  <!-- Main Form Card -->
  <div class="bg-white rounded-3xl p-8 md:p-10 shadow-xl border border-gray-100">

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <!-- Email Field -->
      <div class="space-y-2">
        <%= f.label :email, class: "block text-xs font-bold text-gray-700 uppercase tracking-wider" %>
        <%= f.email_field :email, autofocus: true,
            autocomplete: "email",
            class: "w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5B5CE6] focus:bg-white text-sm text-gray-900 transition",
            placeholder: "Enter your email" %>
      </div>

      <!-- Pending Email Confirmation Alert -->
      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="bg-blue-50 border border-blue-200 text-blue-700 px-4 py-3 rounded-xl text-xs">
          Currently waiting for email confirmation: <span class="font-semibold"><%= resource.unconfirmed_email %></span>
        </div>
      <% end %>

      <!-- New Password -->
      <div class="space-y-2">
        <div class="flex items-center justify-between">
          <%= f.label :password, "New Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider" %>
          <span class="text-[10px] text-gray-400 font-medium">Optional</span>
        </div>
        <p class="text-[11px] text-gray-500">Leave blank if you don't want to change your password.</p>
        
        <% if @minimum_password_length %>
          <p class="text-[10px] text-indigo-600 font-medium">Minimum <%= @minimum_password_length %> characters</p>
        <% end %>

        <%= f.password_field :password,
            autocomplete: "new-password",
            class: "w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5B5CE6] focus:bg-white text-sm text-gray-900 transition",
            placeholder: "Enter a new password" %>
      </div>

      <!-- Confirm New Password -->
      <div class="space-y-2">
        <%= f.label :password_confirmation, "Confirm New Password", class: "block text-xs font-bold text-gray-700 uppercase tracking-wider" %>
        <%= f.password_field :password_confirmation,
            autocomplete: "new-password",
            class: "w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5B5CE6] focus:bg-white text-sm text-gray-900 transition",
            placeholder: "Confirm your new password" %>
      </div>

      <!-- Current Password (Required for edits) -->
      <div class="space-y-2 pt-2 border-t border-gray-100">
        <%= f.label :current_password, class: "block text-xs font-bold text-gray-700 uppercase tracking-wider" %>
        <p class="text-[11px] text-gray-500">Enter your current password to save changes.</p>
        <%= f.password_field :current_password,
            autocomplete: "current-password",
            class: "w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#5B5CE6] focus:bg-white text-sm text-gray-900 transition",
            placeholder: "Enter your current password" %>
      </div>

      <!-- Submit Button -->
      <div class="pt-2">
        <%= f.submit "Update Profile",
            class: "w-full bg-[#2952E3] hover:bg-blue-700 text-white font-bold py-3.5 rounded-xl transition shadow-md hover:shadow-lg text-xs uppercase tracking-wider cursor-pointer" %>
      </div>

    <% end %>

    <!-- Back Link -->
    <div class="text-center mt-6">
      <%= link_to "← Back to Articles", root_path, class: "text-xs font-semibold text-gray-600 hover:text-gray-900 transition" %>
    </div>

    <!-- Divider -->
    <div class="w-full h-px bg-gray-100 my-8"></div>

    <!-- Cancel Account Section (Danger Zone) -->
    <div class="bg-red-50/50 border border-red-100 rounded-2xl p-6">
      <h3 class="text-sm font-bold text-red-900 mb-1">Cancel My Account</h3>
      <p class="text-xs text-red-600/80 mb-4">No longer want to use your account? This action is permanent.</p>

      <%= button_to "Cancel My Account",
          registration_path(resource_name),
          method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete your account?" },
          class: "w-full bg-white hover:bg-red-50 text-red-600 border border-red-200 font-bold py-3 rounded-xl transition text-xs uppercase tracking-wider cursor-pointer shadow-sm" %>
    </div>

  </div>

</div>