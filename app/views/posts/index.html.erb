<% content_for :title, "Articles" %>

<div class="bg-[#F4F6FB] min-h-screen relative overflow-hidden font-sans pb-20">

  <!-- Floating Decorative Pill Shapes -->
  <div class="absolute top-10 -left-10 w-16 h-48 border-[6px] border-[#5B5CE6] rounded-full transform rotate-45 opacity-80"></div>
  <div class="absolute top-40 left-10 w-12 h-32 bg-[#5B5CE6] rounded-full transform -rotate-45 opacity-90"></div>
  <div class="absolute top-64 -left-4 w-16 h-40 border-[6px] border-[#5B5CE6] rounded-full transform rotate-45 opacity-80"></div>

  <div class="absolute top-20 -right-8 w-16 h-48 bg-[#5B5CE6] rounded-full transform -rotate-45 opacity-90"></div>
  <div class="absolute top-60 right-12 w-12 h-32 border-[6px] border-[#5B5CE6] rounded-full transform rotate-45 opacity-80"></div>

  <div class="container mx-auto px-4 max-w-6xl flex flex-col lg:flex-row gap-8 pt-12 relative z-10">

    <!-- MAIN FEED -->
    <main class="w-full lg:w-2/3">

      <!-- Page Heading -->
      <h1 class="text-4xl font-extrabold text-[#5B5CE6] mb-6">For you</h1>

      <!-- Search Bar -->
      <%= form_with url: posts_path, method: :get, local: true, class: "relative max-w-md mb-6" do |f| %>
        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
          <svg class="h-4 w-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
        </div>

        <%= f.search_field :q,
              value: @query,
              placeholder: "Search articles...",
              class: "w-full bg-[#EAECEF] border-none rounded-full py-2.5 pl-10 pr-4 text-sm focus:ring-2 focus:ring-[#5B5CE6] focus:outline-none" %>
      <% end %>

      <!-- Category Tabs -->
      <div class="flex items-center space-x-6 border-b border-gray-200 pb-3 mb-6 text-sm font-semibold text-gray-400 overflow-x-auto">
        <span class="text-[#5B5CE6] border-b-2 border-[#5B5CE6] pb-3 -mb-3 whitespace-nowrap cursor-pointer">All</span>
        <span class="hover:text-gray-600 transition whitespace-nowrap cursor-pointer">Technology</span>
        <span class="hover:text-gray-600 transition whitespace-nowrap cursor-pointer">Environment</span>
        <span class="hover:text-gray-600 transition whitespace-nowrap cursor-pointer">Business</span>
        <span class="hover:text-gray-600 transition whitespace-nowrap cursor-pointer">Politics</span>
        <span class="ml-auto text-gray-500 cursor-pointer">></span>
      </div>

      <!-- Articles List -->
      <div class="space-y-4">
        <% if @posts.any? %>
          <% @posts.each do |post| %>
            <article class="bg-white rounded-2xl p-4 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.1)] flex flex-col md:flex-row gap-4 hover:shadow-md transition group">

              <!-- Thumbnail -->
              <div class="w-full md:w-48 h-48 md:h-32 flex-shrink-0 bg-gray-100 rounded-xl overflow-hidden relative">
                <% if post.thumbnail.attached? %>
                  <%= image_tag post.thumbnail, class: "w-full h-full object-cover group-hover:scale-105 transition duration-300" %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center text-2xl">✍️</div>
                <% end %>
              </div>

              <!-- Content -->
              <div class="flex-1 flex flex-col justify-between">
                <div>
                  <div class="flex justify-between items-start gap-2">
                    <h2 class="text-sm font-bold text-gray-900 leading-tight">
                      <%= link_to post.title, post_path(post), class: "hover:text-[#5B5CE6] transition" %>
                    </h2>

                    <span class="text-[10px] text-gray-400 font-medium whitespace-nowrap mt-0.5">
                      12h ago
                    </span>
                  </div>

                  <p class="text-xs text-gray-500 mt-1.5 line-clamp-2 leading-relaxed pr-4">
                    <%= truncate(strip_tags(post.body.to_s), length: 120) %>
                  </p>
                </div>

                              <!-- Card Footer -->
                <div class="flex justify-between items-center mt-3">
                  <div class="flex items-center gap-2">
                    <!-- Fake Avatar -->
                    <div class="w-5 h-5 rounded-full bg-gray-300 overflow-hidden">
                      <img src="https://ui-avatars.com/api/?name=User&background=random" class="w-full h-full object-cover" />
                    </div>

                    <span class="text-[11px] font-bold text-gray-700 mr-2">Author</span>

                    <span class="px-2 py-0.5 bg-green-500 text-white text-[9px] font-bold rounded-full uppercase tracking-wide">
                      Environment
                    </span>

                    <span class="px-2 py-0.5 bg-black text-white text-[9px] font-bold rounded-full uppercase tracking-wide">
                      Tech
                    </span>
                  </div>

                  <div class="flex items-center gap-3">
                    <div class="flex items-center gap-1.5 text-gray-400 text-xs font-medium">
                      <span>♡ <%= post.likes.size %></span>
                      <span>💬 <%= post.comments.size %></span>
                    </div>

                    <%= link_to "Read More", post_path(post), class: "bg-[#2952E3] hover:bg-blue-700 text-white text-[11px] font-semibold px-4 py-1.5 rounded-full transition shadow-sm" %>
                  </div>
                </div>
              </div>
            </article>
          <% end %>
        <% else %>
          <div class="bg-white rounded-2xl p-8 text-center text-gray-500 text-sm">
            No articles found.
          </div>
        <% end %>
      </div>

      <!-- PAGY PAGE NUMBERS -->
<div class="mt-8 flex justify-center">
  <%== @pagy.series_nav if @pagy.pages > 1 %>
</div>
    </main>

    <!-- RIGHT SIDEBAR -->
    <aside class="w-full lg:w-1/3 space-y-6 lg:mt-0 mt-8">

      <!-- Action Button -->
      <% unless user_signed_in? %>
        <%= link_to "Create Account", new_user_registration_path, class: "block w-full text-center bg-[#2952E3] hover:bg-blue-700 text-white font-medium text-sm py-3 rounded-full shadow-md transition" %>
      <% else %>
        <%= link_to "Write Article", new_post_path, class: "block w-full text-center bg-[#2952E3] hover:bg-blue-700 text-white font-medium text-sm py-3 rounded-full shadow-md transition" %>
      <% end %>

      <!-- Trending Section -->
      <div class="bg-white rounded-2xl p-5 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.1)]">
        <h3 class="text-[13px] font-extrabold text-gray-900 mb-4">Trending</h3>

        <div class="space-y-4">
          <% @posts.first(4).each do |post| %>
            <div class="flex gap-3 items-center group">

              <div class="w-12 h-12 rounded-lg bg-gray-100 flex-shrink-0 overflow-hidden">
                <% if post.thumbnail.attached? %>
                  <%= image_tag post.thumbnail, class: "w-full h-full object-cover group-hover:scale-110 transition duration-300" %>
                <% else %>
                  <div class="w-full h-full flex items-center justify-center text-sm">✍️</div>
                <% end %>
              </div>

              <div class="flex-1">
                <h4 class="text-[11px] font-bold text-gray-900 leading-tight mb-1 group-hover:text-[#5B5CE6] transition line-clamp-2">
                  <%= link_to post.title, post_path(post) %>
                </h4>

                <div class="flex items-center gap-1.5 mt-1">
                  <div class="w-3.5 h-3.5 rounded-full bg-gray-200 overflow-hidden">
                    <img src="https://ui-avatars.com/api/?name=Writer&background=random" class="w-full h-full" />
                  </div>

                  <span class="text-[9px] font-bold text-gray-600">Writer</span>

                  <span class="px-1.5 py-[2px] bg-green-500 text-white text-[8px] font-bold rounded-full uppercase">
                    Environment
                  </span>

                  <span class="px-1.5 py-[2px] bg-[#5B5CE6] text-white text-[8px] font-bold rounded-full uppercase">
                    Tech
                  </span>

                  <span class="text-[9px] text-gray-400 ml-auto">12h ago</span>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>

      <!-- Recommended Users Section -->
      <div class="bg-white rounded-2xl p-5 shadow-[0_2px_10px_-4px_rgba(0,0,0,0.1)]">
        <h3 class="text-[13px] font-extrabold text-gray-900 mb-4">Recommended Users</h3>

        <div class="space-y-4">
          <% ["Joana Marie Jones", "Yousef Hanafi", "Mark Joe Lewis", "Anna Mountain"].each do |name| %>
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-3">

                <div class="w-8 h-8 rounded-full bg-gray-200 border border-gray-100 overflow-hidden">
                  <img src="https://ui-avatars.com/api/?name=<%= name.split.join('+') %>&background=random" class="w-full h-full object-cover" />
                </div>

                <span class="text-xs font-bold text-gray-900"><%= name %></span>
              </div>

              <button class="bg-[#2952E3] hover:bg-blue-700 text-white text-[10px] font-semibold px-4 py-1 rounded-full transition">
                Follow
              </button>
            </div>
          <% end %>
        </div>
      </div>

    </aside>

  </div>
</div>