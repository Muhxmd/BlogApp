<% content_for :title, "Edit Article" %>

<div class="max-w-3xl mx-auto px-4 py-12 font-sans">

  <!-- Heading -->
  <div class="text-center mb-8">
    <h1 class="text-4xl font-black text-gray-900 tracking-tight mb-2">Edit Your Article</h1>
    <p class="text-gray-500 text-sm">Make changes to your article below.</p>
  </div>

  <!-- Renders the shared Tailwind Form -->
  <%= render "form", post: @post %>

  <!-- Footer Link Back -->
  <div class="text-center mt-8">
    <%= link_to "← Back to All Articles", posts_path, class: "text-sm font-semibold text-[#2952E3] hover:text-blue-800 transition" %>
  </div>

</div>