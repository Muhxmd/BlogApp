<% content_for :title, "Edit Article" %>

<div class="form-page">

  <div class="form-heading">
    <h1>Edit Your Article</h1>
    <p>Make changes to your article below.</p>
  </div>

  <%= render "form", post: @post %>

  <div class="form-footer">
    <%= link_to "← Back to All Articles", posts_path, class: "back-link" %>
  </div>

</div>