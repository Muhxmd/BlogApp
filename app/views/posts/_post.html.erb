<% content_for :title, post.title %>

<div class="max-w-4xl mx-auto px-4 py-12 font-sans">
  <article class="bg-white rounded-3xl p-8 md:p-14 shadow-xl border border-gray-100">

    <!-- Optional Thumbnail Display -->
    <% if post.thumbnail.attached? %>
      <div class="w-full h-72 md:h-96 rounded-2xl overflow-hidden mb-8 shadow-md">
        <%= image_tag post.thumbnail, alt: post.title, class: "w-full h-full object-cover" %>
      </div>
    <% end %>

    <!-- Article Title -->
    <h1 class="text-3xl md:text-5xl font-black text-gray-900 tracking-tight leading-tight mb-6">
      <%= post.title %>
    </h1>

    <div class="w-full h-px bg-gray-100 my-6"></div>

    <!-- Article Body -->
    <div class="prose prose-blue max-w-none text-gray-700 leading-relaxed space-y-4 mb-10">
      <%= post.body %>
    </div>

    <div class="w-full h-px bg-gray-100 my-8"></div>

    <!-- TURBO FRAME -->
    <%= turbo_frame_tag "likes_and_comments_#{post.id}" do %>
      
      <!-- LIKES -->
      <div class="flex items-center gap-4 mb-8">
        <p class="font-bold text-lg text-gray-800"><%= post.likes.size %> Likes</p>
        
        <% if user_signed_in? %>
          <% like = post.likes.find_by(user: current_user) %>
          
          <!-- CHANGED: Added items-stretch so the forms inside pull to the full 100% height -->
          <div class="flex items-stretch bg-gray-100 rounded-full overflow-hidden shadow-sm border border-gray-200 h-10">
            
            <% if like %>
              <!-- LIKED STATE -->
              <!-- CHANGED: Added form: { class: "h-full" } and w-full h-full to the button -->
              <%= button_to post_like_path(post, like), method: :delete, form: { class: "h-full" }, class: "flex items-center justify-center gap-2 px-5 w-full h-full bg-[#2952E3] text-white font-semibold text-sm transition" do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
                  <path d="M7.493 18.5c-.425 0-.82-.236-.975-.632A7.48 7.48 0 0 1 6 15.125c0-1.75.599-3.358 1.602-4.634.151-.192.373-.309.6-.397.473-.183.89-.514 1.212-.924a9.042 9.042 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V2.75A.75.75 0 0 1 15 2a2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-.987.729-1.605.729H14.23c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23h-1.122ZM6 18.5A2.25 2.25 0 0 0 3.75 20.75v-7.5A2.25 2.25 0 0 0 6 11h.75v7.5H6Z" />
                </svg>
                Liked
              <% end %>
            <% else %>
              <!-- UNLIKED STATE -->
              <%= button_to post_likes_path(post), method: :post, form: { class: "h-full" }, class: "flex items-center justify-center gap-2 px-5 w-full h-full text-gray-700 font-semibold hover:bg-gray-200 transition text-sm cursor-pointer" do %>
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.633 10.25c.806 0 1.533-.446 2.031-1.08a9.041 9.041 0 0 1 2.861-2.4c.723-.384 1.35-.956 1.653-1.715a4.498 4.498 0 0 0 .322-1.672V2.75a.75.75 0 0 1 .75-.75 2.25 2.25 0 0 1 2.25 2.25c0 1.152-.26 2.243-.723 3.218-.266.558.107 1.282.725 1.282m0 0h3.126c1.026 0 1.945.694 2.054 1.715.045.422.068.85.068 1.285a11.95 11.95 0 0 1-2.649 7.521c-.388.482-.987.729-1.605.729H13.46c-.483 0-.964-.078-1.423-.23l-3.114-1.04a4.501 4.501 0 0 0-1.423-.23H5.904m10.598-9.75H14.25M5.904 18.5c.083.205.173.405.28.602.197.36.6.598 1.01.598h.11a3.75 3.75 0 0 0 1.272-.224l3.114-1.04A4.5 4.5 0 0 1 13.46 18.25H18.25m-12.346 0H5.904m0 0A2.25 2.25 0 0 1 3.75 16.25v-7.5A2.25 2.25 0 0 1 5.904 6.5h.11c.41 0 .813.238 1.01.598.107.197.197.397.28.602m11.25 10.875v-1.5" />
                </svg>
                Like
              <% end %>
            <% end %>

            <div class="w-px h-full bg-gray-300"></div>

            <!-- DISLIKE BUTTON -->
            <% if like %>
              <%= button_to post_like_path(post, like), method: :delete, form: { class: "h-full" }, class: "flex items-center justify-center px-4 w-full h-full text-gray-700 hover:bg-gray-200 transition text-sm cursor-pointer" do %>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5" />
                </svg>
              <% end %>
            <% else %>
              <button class="flex items-center justify-center px-4 h-full text-gray-400 cursor-not-allowed">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.096c.5 0 .905-.405.905-.904 0-.715.211-1.413.608-2.008L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5" />
                </svg>
              </button>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm text-gray-500">Sign in to like this post.</p>
        <% end %>
      </div>

      <!-- COMMENTS -->
      <div class="mb-8">
        <h2 class="text-2xl font-bold mb-6 text-gray-900">Comments (<%= post.comments.size %>)</h2>

        <% if user_signed_in? %>
          <%= form_with(model: [post, post.comments.build], class: "mb-8") do |form| %>
            <div class="mb-3">
              <%= form.text_area :content, rows: 3, placeholder: "Add a comment...", class: "w-full border border-gray-200 rounded-xl p-4 focus:outline-none focus:ring-2 focus:ring-[#2952E3] transition resize-none text-sm text-gray-700 bg-gray-50" %>
            </div>
            <%= form.submit "Post Comment", class: "px-6 py-2 bg-[#2952E3] text-white font-bold rounded-full hover:bg-blue-700 transition cursor-pointer text-sm" %>
          <% end %>
        <% else %>
          <p class="text-sm text-gray-500 mb-8 border-b border-gray-100 pb-6">Sign in to leave a comment.</p>
        <% end %>

        <div class="space-y-4">
          <% post.comments.each do |comment| %>
            <% next if comment.new_record? %>
            <div class="p-5 border border-gray-100 rounded-2xl bg-gray-50">
              <div class="flex justify-between items-start mb-2">
                <p class="text-sm font-bold text-gray-900">User #<%= comment.user_id %></p>
                <% if comment.user == current_user %>
                  <%= button_to "Delete", post_comment_path(post, comment), method: :delete, class: "text-red-500 text-xs font-bold hover:text-red-700 hover:underline transition uppercase tracking-wide cursor-pointer" %>
                <% end %>
              </div>
              <p class="text-gray-700 text-sm leading-relaxed whitespace-pre-wrap"><%= comment.content %></p>
            </div>
          <% end %>
        </div>
      </div>
    <% end %> <!-- END TURBO FRAME -->

    <!-- Article Footer -->
    <div class="flex items-center justify-between pt-8 border-t border-gray-100">
      <%= link_to "← Back to Articles", posts_path, class: "inline-flex items-center text-xs font-bold text-[#2952E3] hover:text-blue-800 transition tracking-wider uppercase" %>
    </div>

  </article>
</div>