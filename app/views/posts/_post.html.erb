<div class="article-page py-5">

  <div class="article-card">

   

    <h1 class="article-title">
      <%= post.title %>
    </h1>

    <div class="article-divider"></div>

    <div class="article-body">
      <%= post.body %>
    </div>

    <div class="article-footer">

      <%= link_to "← Back to Articles",
          root_path,
          class: "btn btn-outline-primary" %>

    </div>

  </div>

</div>