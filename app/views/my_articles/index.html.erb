<% content_for :title, "My Articles" %>

<div class="max-w-5xl mx-auto px-4 py-12 font-sans">

  <!-- Header Section -->
  <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-10 gap-4 border-b border-gray-100 pb-6">
    <div>
      <span class="text-[10px] font-extrabold text-[#5B5CE6] tracking-widest uppercase bg-blue-50 px-3 py-1 rounded-full">
        ✦ DASHBOARD
      </span>
      <h1 class="text-3xl md:text-4xl font-black text-gray-900 tracking-tight mt-2">
        My Articles
      </h1>
      <p class="text-gray-500 text-xs md:text-sm mt-1">Manage, edit, or publish your personal stories.</p>
    </div>

    <%= link_to "+ Write New Article", new_post_path, class: "bg-[#2952E3] hover:bg-blue-700 text-white text-xs font-bold px-6 py-3 rounded-xl transition shadow-md hover:shadow-lg uppercase tracking-wider" %>
  </div>

  <!-- Articles List / Grid -->
  <% if @posts.any? %>
    <div class="space-y-4">
      <% @posts.each do |post| %>
        <div class="bg-white rounded-2xl p-5 md:p-6 shadow-sm hover:shadow-md border border-gray-100 transition duration-300 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 group">
          
          <!-- Left: Post Info -->
          <div class="flex items-center gap-4 flex-1">
            <div class="w-16 h-16 rounded-xl bg-gray-50 border border-gray-100 flex-shrink-0 overflow-hidden flex items-center justify-center">
              <% if post.thumbnail.attached? %>
                <%= image_tag post.thumbnail, alt: post.title, class: "w-full h-full object-cover" %>
              <% else %>
                <span class="text-2xl">✍️</span>
              <% end %>
            </div>

            <div>
              <span class="text-[10px] font-bold text-gray-400 uppercase tracking-widest block mb-1">
                Published <%= post.created_at.strftime("%b %d, %Y") %>
              </span>
              <h3 class="text-base font-bold text-gray-900 group-hover:text-[#5B5CE6] transition line-clamp-1">
                <%= link_to post.title, post_path(post) %>
              </h3>
              <p class="text-xs text-gray-500 line-clamp-1 mt-0.5">
                <%= truncate(strip_tags(post.body.to_s), length: 80) %>
              </p>
            </div>
          </div>

          <!-- Right: Actions -->
          <div class="flex items-center gap-3 w-full md:w-auto justify-end pt-3 md:pt-0 border-t md:border-t-0 border-gray-100">
            <%= link_to "View", post_path(post), class: "px-4 py-2 bg-gray-50 hover:bg-gray-100 text-gray-700 text-xs font-bold rounded-xl transition" %>
            <%= link_to "Edit", edit_post_path(post), class: "px-4 py-2 bg-blue-50 hover:bg-blue-100 text-[#2952E3] text-xs font-bold rounded-xl transition" %>
            <%= link_to "Delete", post_path(post), data: { turbo_method: :delete, turbo_confirm: "Are you sure you want to delete this article?" }, class: "px-4 py-2 bg-red-50 hover:bg-red-100 text-red-600 text-xs font-bold rounded-xl transition" %>
          </div>

        </div>
      <% end %>
    </div>
  <% else %>
    <div class="bg-white border-2 border-dashed border-gray-200 rounded-3xl p-16 text-center max-w-xl mx-auto shadow-sm">
      <div class="text-4xl mb-3">📝</div>
      <h3 class="text-xl font-black text-gray-900 mb-1">You haven't written any articles yet</h3>
      <p class="text-gray-500 text-xs mb-6">Share your unique voice and stories with the community.</p>
      <%= link_to "Create Your First Article", new_post_path, class: "inline-block bg-[#2952E3] hover:bg-blue-700 text-white font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-xl transition shadow-md" %>
    </div>
  <% end %>

</div>