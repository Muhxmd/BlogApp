<% content_for :title, "Home" %>

<!-- Homepage Hero -->
<section class="py-12 md:py-16 relative overflow-hidden font-sans">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="bg-[#F4F6FB] rounded-[40px] p-8 md:p-16 flex flex-col-reverse md:flex-row items-center gap-12 relative shadow-sm">
      
      <!-- Left Side: Hero Visual -->
      <div class="w-full md:w-1/2 flex justify-center relative">
        <div class="w-72 h-56 bg-white rounded-2xl flex items-center justify-center shadow-md relative z-10 hover:-translate-y-2 transition-transform duration-300">
          <span class="text-7xl drop-shadow-md">✍️</span>
        </div>
        
        <!-- Decorative Shapes -->
        <div class="absolute top-4 left-10 md:left-20 w-8 h-8 bg-[#5B5CE6] rounded-full shadow-md animate-bounce" style="animation-duration: 3s;"></div>
        <div class="absolute bottom-8 left-4 md:left-12 w-10 h-10 bg-[#5B5CE6] rounded-full shadow-md animate-pulse"></div>
        <div class="absolute top-10 right-4 md:right-16 w-6 h-6 bg-[#5B5CE6] rounded-full shadow-md"></div>
      </div>

      <!-- Right Side: Hero Content -->
      <div class="w-full md:w-1/2 text-center md:text-left z-10">
        <span class="inline-block text-[10px] font-bold text-[#5B5CE6] tracking-wider uppercase mb-4 bg-blue-50 px-3 py-1 rounded-full">
          ✦ YOUR PERSONAL BLOG
        </span>
        <h1 class="text-5xl md:text-6xl font-black text-gray-900 leading-tight mb-4 tracking-tight">
          Write Your <span class="text-[#5B5CE6]">Article</span> here.
        </h1>
        <p class="text-gray-600 mb-8 max-w-md mx-auto md:mx-0">
          Discover interesting articles, explore new ideas, and share your thoughts with the world.
        </p>
        
        <% if user_signed_in? %>
          <%= link_to "+ Write an Article", new_post_path, class: "inline-block bg-[#2952E3] hover:bg-blue-700 text-white font-bold px-8 py-3.5 rounded-lg transition shadow-lg hover:shadow-xl hover:-translate-y-1 text-sm" %>
        <% else %>
          <%= link_to "Start Exploring", posts_path, class: "inline-block bg-[#2952E3] hover:bg-blue-700 text-white font-bold px-8 py-3.5 rounded-lg transition shadow-lg hover:shadow-xl hover:-translate-y-1 text-sm" %>
        <% end %>
      </div>

    </div>
  </div>
</section>

<!-- BEST ARTICLE TODAY SECTION -->
<section class="relative bg-[#5B5CE6] py-24 overflow-hidden font-sans my-12">
  
  <!-- Floating Outlined Pills -->
  <div class="absolute top-10 left-[20%] w-12 h-40 border-[4px] border-white/30 rounded-full transform -rotate-45"></div>
  <div class="absolute bottom-10 left-[10%] w-12 h-32 border-[4px] border-white/30 rounded-full transform rotate-45"></div>
  <div class="absolute top-20 right-[5%] w-12 h-40 border-[4px] border-white/30 rounded-full transform rotate-45"></div>
  <div class="absolute bottom-10 right-[20%] w-12 h-48 border-[4px] border-white/30 rounded-full transform -rotate-45"></div>

  <div class="container mx-auto px-4 max-w-7xl relative z-10">
    
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-12 gap-4">
      <div>
        <h2 class="text-4xl md:text-5xl font-extrabold text-white leading-tight">
          Best Article Today
        </h2>
      </div>
      <%= link_to "See All Articles →", posts_path, class: "inline-block bg-white text-[#5B5CE6] font-bold px-6 py-2.5 rounded-full hover:bg-gray-100 transition shadow-md text-sm" %>
    </div>

    <!-- Cards Grid (No scrolling) -->
    <% if @posts.any? %>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <% @posts.first(3).each do |post| %>
          <div class="bg-white rounded-3xl p-5 shadow-xl flex flex-col group hover:-translate-y-2 transition-all duration-300">
            
            <!-- Card Image -->
            <div class="w-full h-48 bg-gray-100 rounded-2xl mb-4 overflow-hidden relative shadow-inner">
              <% if post.thumbnail.attached? %>
                <%= image_tag post.thumbnail, alt: post.title, class: "w-full h-full object-cover group-hover:scale-110 transition duration-500" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-4xl bg-gray-50">✍️</div>
              <% end %>
              <span class="absolute bottom-3 left-3 px-2.5 py-1 bg-green-500 text-white text-[10px] font-bold rounded-full uppercase tracking-wide shadow-sm">Article</span>
            </div>
            
            <!-- Card Content -->
            <h3 class="font-bold text-base text-gray-900 leading-snug mb-2 group-hover:text-[#5B5CE6] transition line-clamp-2">
              <%= post.title %>
            </h3>
            <p class="text-xs text-gray-500 line-clamp-2 mb-6 flex-1 leading-relaxed">
              <%= truncate(strip_tags(post.body.to_s), length: 90) %>
            </p>
            
            <!-- Card Footer -->
            <div class="flex items-center justify-between mt-auto pt-4 border-t border-gray-100">
              <div class="flex flex-col">
                <span class="text-[10px] text-gray-400 mb-1 font-medium"><%= post.created_at.strftime("%b %d") %></span>
                <div class="flex items-center gap-2 text-[10px] text-gray-400 font-medium">
                  <span>♡ 41</span>
                  <span>💬 21</span>
                </div>
              </div>
              <%= link_to "Read More", post_path(post), class: "bg-[#2952E3] hover:bg-blue-700 text-white text-xs font-bold px-5 py-2 rounded-full transition shadow-sm hover:shadow" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="text-white text-center w-full py-10 font-medium">No articles available yet.</div>
    <% end %>

  </div>
</section>
<!-- Newsletter Subscribe Section -->
<section class="py-12 mb-12 font-sans">
  <div class="container mx-auto px-4 max-w-5xl">
    <!-- Taller, vibrant gradient box matching your site's exact theme -->
    <div class="bg-gradient-to-r from-[#5B5CE6] via-[#4F46E5] to-[#2952E3] rounded-[40px] p-12 md:p-24 flex flex-col md:flex-row items-center relative overflow-hidden shadow-2xl">
      
      <!-- Floating Outlined Pills (Matching your Best Article section style) -->
      <div class="absolute top-6 left-10 w-16 h-12 border-[3px] border-white/20 rounded-full transform -rotate-45 pointer-events-none"></div>
      <div class="absolute bottom-8 left-20 w-12 h-36 border-[3px] border-white/25 rounded-full transform rotate-45 pointer-events-none"></div>
      <div class="absolute top-12 right-12 w-14 h-44 border-[3px] border-white/20 rounded-full transform rotate-12 pointer-events-none"></div>
      <div class="absolute bottom-6 right-28 w-10 h-10 bg-white/10 rounded-full blur-[1px] pointer-events-none"></div>

      <!-- Left: Glassmorphism Icon Box to add height and style -->
      <div class="w-full md:w-1/3 flex justify-center mb-8 md:mb-0 relative z-10">
        <div class="w-32 h-32 md:w-40 md:h-40 bg-white/10 backdrop-blur-md rounded-3xl border border-white/20 flex items-center justify-center shadow-2xl transform hover:scale-105 transition-transform duration-500">
          <span class="text-6xl drop-shadow-lg">✉️</span>
        </div>
      </div>

      <!-- Right: Subscribe Content -->
      <div class="w-full md:w-2/3 text-center md:text-left z-10 pl-0 md:pl-12">
        <span class="inline-block text-[10px] font-extrabold text-white/95 tracking-widest uppercase bg-white/20 px-3.5 py-1.5 rounded-full mb-4 backdrop-blur-sm shadow-sm">
          ✦ EXCLUSIVE PERKS
        </span>
        <h2 class="text-4xl md:text-5xl font-black text-white mb-4 tracking-tight drop-shadow-sm">
          Stay in the loop
        </h2>
        <p class="text-white/90 mb-8 text-sm md:text-base max-w-md mx-auto md:mx-0 leading-relaxed font-medium">
          Subscribe to our newsletter and get up to 40% off on our exclusive services and latest stories.
        </p>

        <!-- Ultra-stylish form container -->
        <form class="flex flex-col sm:flex-row w-full max-w-md mx-auto md:mx-0 bg-white rounded-2xl shadow-2xl overflow-hidden p-2 gap-2 sm:gap-0">
          <label for="newsletter-email" class="sr-only">Email Address</label>
          <input type="email" id="newsletter-email" name="email" placeholder="Enter your email address" required class="flex-1 px-4 py-3.5 bg-transparent border-none focus:outline-none text-sm text-gray-900 placeholder-gray-400 font-medium">
          <button type="submit" class="bg-[#1E2028] hover:bg-black text-white font-bold px-8 py-3.5 rounded-xl transition uppercase text-xs tracking-wider shadow-md">
            Subscribe
          </button>
        </form>
      </div>

    </div>
  </div>
</section>

<!-- FOOTER -->
<footer class="bg-[#181A20] text-white py-6 font-sans border-t border-gray-800">
  <div class="container mx-auto px-4 max-w-6xl">
    <div class="flex flex-col md:flex-row justify-between items-center gap-4 text-center md:text-left">
      
      <!-- Brand -->
      <div>
        <span class="text-base font-black tracking-wider uppercase text-[#5B5CE6]">BLOG.</span>
      </div>

      <!-- Quick Links -->
      <div class="flex items-center gap-6 text-xs font-medium text-gray-400">
        <%= link_to "Home", root_path, class: "hover:text-[#5B5CE6] transition" %>
        <%= link_to "Articles", posts_path, class: "hover:text-[#5B5CE6] transition" %>
        <% if user_signed_in? %>
          <%= link_to "Write Article", new_post_path, class: "hover:text-[#5B5CE6] transition" %>
        <% else %>
          <%= link_to "Sign In", new_user_session_path, class: "hover:text-[#5B5CE6] transition" %>
        <% end %>
      </div>

      <!-- Copyright -->
      <div class="text-[11px] text-gray-500">
        © 2026 Blog. All rights reserved.
      </div>

    </div>
  </div>
</footer>