<nav class="bg-white shadow-sm border-b border-gray-100 sticky top-0 z-50">
  <div class="container mx-auto px-4">
    <div class="flex justify-between items-center h-16">
      
      <!-- Logo -->
      <%= link_to root_path, class: "flex items-center no-underline" do %>
        <span class="text-2xl font-black tracking-tighter text-gray-900 hover:text-blue-600 transition">BLOG</span>
      <% end %>

      <!-- Desktop Navigation Links -->
      <div class="hidden lg:flex lg:items-center lg:space-x-8">
        
        <%= link_to "Home", root_path, class: "text-gray-600 hover:text-blue-600 font-medium text-sm transition" %>
        <%= link_to "Articles", posts_path, class: "text-gray-600 hover:text-blue-600 font-medium text-sm transition" %>

        <% if user_signed_in? %>
          <%= link_to "Add Article", new_post_path, class: "text-gray-600 hover:text-blue-600 font-medium text-sm transition" %>
          <%= link_to "Your Articles", my_articles_path, class: "text-gray-600 hover:text-blue-600 font-medium text-sm transition" %>
          <%= link_to "Profile", edit_user_registration_path, class: "text-gray-600 hover:text-blue-600 font-medium text-sm transition" %>
          
          <!-- Sign Out -->
          <%= button_to "Sign Out", destroy_user_session_path, 
                method: :delete, 
                class: "text-red-500 hover:text-red-700 font-medium text-sm bg-transparent border-none cursor-pointer transition",
                form: { class: "inline-block m-0 p-0" },
                onclick: "return confirm('Are you sure?');" %>
        <% else %>
          <%= link_to "Log In", new_user_session_path, class: "text-gray-600 hover:text-blue-600 font-medium text-sm transition" %>
          <%= link_to "Sign Up", new_user_registration_path, class: "px-4 py-2 bg-blue-600 text-white font-medium text-sm rounded-lg hover:bg-blue-700 transition shadow-sm" %>
        <% end %>
        
      </div>

      <!-- Mobile Menu Button (Hamburger) -->
      <div class="flex items-center lg:hidden">
        <button type="button" 
                class="text-gray-600 hover:text-gray-900 focus:outline-none p-2" 
                aria-controls="mobile-menu" 
                aria-expanded="false"
                onclick="document.getElementById('mobile-menu').classList.toggle('hidden')">
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Menu (Hidden by default) -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-gray-100">
    <div class="px-4 pt-2 pb-6 space-y-2 flex flex-col">
      
      <%= link_to "Home", root_path, class: "block px-3 py-2 text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 rounded-md" %>
      <%= link_to "Articles", posts_path, class: "block px-3 py-2 text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 rounded-md" %>

      <% if user_signed_in? %>
        <%= link_to "Add Article", new_post_path, class: "block px-3 py-2 text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 rounded-md" %>
        <%= link_to "Your Articles", my_articles_path, class: "block px-3 py-2 text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 rounded-md" %>
        <%= link_to "Profile", edit_user_registration_path, class: "block px-3 py-2 text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 rounded-md" %>
        
        <div class="px-3 py-2">
          <%= button_to "Sign Out", destroy_user_session_path, 
                method: :delete, 
                class: "w-full text-left text-base font-medium text-red-500 hover:text-red-700 bg-transparent border-none cursor-pointer",
                form: { class: "m-0 p-0" },
                onclick: "return confirm('Are you sure?');" %>
        </div>
      <% else %>
        <%= link_to "Log In", new_user_session_path, class: "block px-3 py-2 text-base font-medium text-gray-700 hover:text-blue-600 hover:bg-gray-50 rounded-md" %>
        <%= link_to "Sign Up", new_user_registration_path, class: "block px-3 py-2 text-base font-medium text-blue-600 hover:text-blue-800 hover:bg-blue-50 rounded-md" %>
      <% end %>

    </div>
  </div>
</nav>