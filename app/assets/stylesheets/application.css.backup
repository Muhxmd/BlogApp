/*
 * Blog App — cleaned application.css
 * Preserves navbar, static hero, article pages, forms, Devise-related styles,
 * and Bootstrap card compatibility. Latest Articles has one unified style.
 * Carousel-specific styles have been removed.
 */

/* =========================
   THEME + GLOBAL
========================= */
:root {
  --primary: #5145e5;
  --primary-dark: #4035c9;
  --ink: #20212b;
  --text: #353746;
  --muted: #686b78;
  --border: #e5e7ef;
}

* { box-sizing: border-box; }

body {
  min-height: 100vh;
  margin: 0;
  color: var(--text);
  font-family: Arial, sans-serif;
  background: linear-gradient(135deg, #edf3ff 0%, #e7edff 52%, #f2edff 100%);
  background-attachment: fixed;
}

h1, h2, h3, h4 {
  color: var(--ink);
  font-weight: 700;
}

.site-content { animation: pageFadeIn .3s ease-in-out; }

@keyframes pageFadeIn {
  from { opacity: 0; transform: translateY(5px); }
  to { opacity: 1; transform: translateY(0); }
}

.flash-popup {
  position: fixed;
  top: 20px;
  right: 20px;
  z-index: 9999;
  min-width: 300px;
  box-shadow: 0 4px 12px rgba(0, 0, 0, .2);
}

.btn {
  border-radius: 7px;
  font-weight: 600;
  transition: all .2s ease;
}

.btn-primary {
  background: var(--primary);
  border-color: var(--primary);
}

.btn-primary:hover {
  background: var(--primary-dark);
  border-color: var(--primary-dark);
}

.btn-danger { background: #dc3545; border-color: #dc3545; }
.bao { margin-top: 20px; }

/* =========================
   MINIMAL NAVBAR
========================= */
.custom-navbar {
  display: flex;
  align-items: center;
  min-height: 72px;
  padding: 12px 6%;
  background: #f8f9fc !important;
  border-bottom: 1px solid #e5e7eb;
  box-shadow: 0 2px 8px rgba(0, 0, 0, .04);
}

.custom-navbar .brand-logo {
  margin: 0;
  padding: 0;
  text-decoration: none;
}

.custom-navbar .brand-blog {
  color: var(--ink);
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -1px;
}

.custom-navbar .brand-blog::after {
  content: ".";
  color: var(--primary);
}

.custom-navbar .navbar-nav {
  align-items: center;
  gap: 24px;
}

.custom-navbar .nav-minimal {
  padding: 8px 0 !important;
  color: var(--text) !important;
  background: transparent;
  border: 0;
  font-size: 14px;
  font-weight: 500;
  text-decoration: none;
  transition: color .2s ease;
}

.custom-navbar .nav-minimal:hover,
.custom-navbar .nav-signout:hover {
  color: var(--primary) !important;
}

.custom-navbar .logout-form {
  display: inline;
  margin: 0;
  padding: 0;
}

.custom-navbar .nav-signout {
  padding: 8px 0;
  color: var(--text) !important;
  background: transparent;
  border: 0;
  font-family: inherit;
  font-size: 14px;
  font-weight: 500;
  cursor: pointer;
}

/* =========================
   STATIC HOMEPAGE HERO
   (No carousel styles)
========================= */
.blog-hero-new {
  width: min(1240px, calc(100% - 48px));
  margin: 42px auto 54px;
  padding: 58px clamp(28px, 5vw, 76px);
  overflow: hidden;
  background: linear-gradient(115deg, #f9faff 0%, #f3f4ff 55%, #f8f5ff 100%);
  border: 1px solid rgba(111, 99, 220, .10);
  border-radius: 26px;
  box-shadow: 0 14px 40px rgba(45, 48, 100, .07);
}

.blog-hero-new .hero-inner {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, .95fr);
  align-items: center;
  gap: clamp(36px, 6vw, 86px);
  max-width: 1120px;
  margin: 0 auto;
}

.blog-hero-new .hero-visual {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 320px;
}

.blog-hero-new .hero-image-card {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  max-width: 430px;
  height: 270px;
  background: linear-gradient(135deg, #e8eff2, #cbdfe6);
  border-radius: 54px;
}

.blog-hero-new .hero-illustration {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  border-radius: inherit;
  font-size: clamp(76px, 8vw, 104px);
}

.blog-hero-new .hero-shape {
  position: absolute;
  z-index: 2;
  display: block;
  background: #6246ea;
  border-radius: 50%;
}

.blog-hero-new .hero-circle-one {
  top: 2px;
  left: 3%;
  width: 62px;
  height: 62px;
}

.blog-hero-new .hero-circle-two {
  bottom: 12px;
  left: 0;
  width: 42px;
  height: 42px;
}

.blog-hero-new .hero-circle-three {
  top: 12%;
  right: 0;
  width: 52px;
  height: 52px;
}

.blog-hero-new .hero-content-new {
  min-width: 0;
  max-width: 500px;
}

.blog-hero-new .hero-badge-new {
  display: inline-block;
  margin-bottom: 22px;
  padding: 9px 16px;
  color: var(--primary);
  background: #e9e5ff;
  border-radius: 30px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1px;
}

.blog-hero-new .hero-content-new h1 {
  margin: 0 0 20px;
  color: var(--ink);
  font-size: clamp(40px, 4.2vw, 60px);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -1.8px;
  text-align: left;
}

.blog-hero-new .hero-content-new h1 span {
  display: block;
  color: var(--primary);
}

.blog-hero-new .hero-content-new p {
  max-width: 460px;
  margin: 0 0 26px;
  color: var(--muted);
  font-size: 16px;
  line-height: 1.8;
}

.blog-hero-new .hero-btn-new {
  display: inline-block;
  padding: 14px 26px;
  color: #fff;
  background: var(--primary);
  border: 1px solid var(--primary);
  border-radius: 9px;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none;
  transition: all .2s ease;
}

.blog-hero-new .hero-btn-new:hover {
  color: #fff;
  background: var(--primary-dark);
  border-color: var(--primary-dark);
  text-decoration: none;
  transform: translateY(-2px);
  box-shadow: 0 7px 18px rgba(81, 69, 229, .2);
}

/* =========================
   LATEST / FEATURED ARTICLES
========================= */
.homepage-articles {
  width: 100%;
  max-width: none;
  margin: 0;
  padding: 70px 24px 80px;
  background: linear-gradient(135deg, #5145e5 0%, #7162ed 55%, #8b7cf6 100%);
}

.homepage-articles .section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24px;
  max-width: 1180px;
  margin: 0 auto 38px;
}

.homepage-articles .section-label {
  color: #dedaff;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 1.8px;
}

.homepage-articles .section-heading h2 {
  margin: 10px 0;
  color: #fff;
  font-size: 36px;
  font-weight: 800;
  letter-spacing: -.8px;
}

.homepage-articles .section-heading p {
  margin: 0;
  color: #e4e0ff;
  font-size: 15px;
  line-height: 1.7;
}

.homepage-articles .view-all-link {
  color: #fff;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none !important;
  white-space: nowrap;
}

.homepage-articles .view-all-link:hover { color: #e0dcff; }

.homepage-articles > .row {
  max-width: 1180px;
  margin: 0 auto;
  align-items: stretch;
}

.homepage-articles .blog-post-card {
  display: flex;
  flex-direction: column;
  width: 100%;
  height: 100%;
  min-width: 0;
  padding: 0;
  overflow: hidden;
  background: #fff;
  border: 1px solid rgba(255, 255, 255, .6);
  border-radius: 16px;
  box-shadow: 0 12px 30px rgba(31, 24, 100, .14);
  transition: transform .25s ease, box-shadow .25s ease;
}

.homepage-articles .blog-post-card:hover {
  transform: translateY(-6px);
  box-shadow: 0 18px 38px rgba(31, 24, 100, .22);
}

.homepage-articles .article-cover {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 100%;
  height: 185px;
  overflow: hidden;
  background: #f2efff;
  border-bottom: 1px solid #eae6ff;
}

.homepage-articles .article-cover .post-thumbnail {
  display: block;
  width: 100%;
  height: 100%;
  padding: 8px;
  object-fit: contain;
  object-position: center;
  transition: transform .3s ease;
}

.homepage-articles .blog-post-card:hover .post-thumbnail {
  transform: scale(1.03);
}

.homepage-articles .article-cover-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #f1edff, #e5edff);
}

.homepage-articles .article-cover-placeholder span {
  font-size: 38px;
  line-height: 1;
}

.homepage-articles .article-cover-placeholder small {
  color: #6554d9;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 1.3px;
}

.homepage-articles .post-card-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  padding: 22px;
}

.homepage-articles .post-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
  padding: 0;
  background: transparent;
  border: 0;
}

.homepage-articles .post-category {
  display: inline-block;
  padding: 6px 10px;
  color: #5b4be0;
  background: #f0edff;
  border-radius: 5px;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 1px;
}

.homepage-articles .post-star {
  color: #8068ed;
  font-size: 18px;
}

.homepage-articles .post-card-content h3 {
  margin: 0 0 12px;
  color: #20212b;
  font-size: 21px;
  font-weight: 700;
  line-height: 1.4;
  overflow-wrap: anywhere;
}

.homepage-articles .post-card-content p {
  margin: 0 0 22px;
  color: #737586;
  font-size: 14px;
  line-height: 1.75;
  overflow-wrap: anywhere;
}

.homepage-articles .post-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px solid #eeedf5;
}

.homepage-articles .post-read-time {
  color: #9294a5;
  font-size: 11px;
  font-weight: 600;
}

.homepage-articles .post-read-link {
  color: #5145e5;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none !important;
}

.homepage-articles .post-read-link:hover { color: #4035c9; }

.homepage-articles .empty-blog {
  max-width: 1180px;
  margin: 0 auto;
  padding: 45px 25px;
  text-align: center;
  background: #fff;
  border-radius: 16px;
}

.homepage-articles .empty-blog h3 {
  color: var(--ink);
  font-size: 24px;
}

.homepage-articles .empty-blog p {
  margin-bottom: 25px;
  color: #737586;
}

.homepage-articles .hero-btn {
  display: inline-block;
  padding: 13px 24px;
  color: #fff !important;
  background: var(--primary);
  border-radius: 9px;
  font-size: 14px;
  font-weight: 700;
  text-decoration: none !important;
  box-shadow: 0 5px 15px rgba(124, 58, 237, .20);
  transition: all .25s ease;
}

.homepage-articles .hero-btn:hover {
  color: #fff;
  background: var(--primary-dark);
  transform: translateY(-2px);
}

/* =========================
   ARTICLE READING PAGE
========================= */
.article-page {
  max-width: 940px;
  min-height: 70vh;
  margin: 0 auto;
  padding: 42px 20px;
}

.article-card {
  padding: 44px;
  background: #fff;
  border-radius: 14px;
  box-shadow: 0 5px 25px rgba(0, 0, 0, .06);
}

.article-title {
  margin: 0 0 25px;
  color: var(--ink);
  font-size: 36px;
  font-weight: 700;
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.article-divider {
  width: 70px;
  height: 3px;
  margin-bottom: 30px;
  background: var(--primary);
  border-radius: 5px;
}

.article-body {
  color: #444;
  font-size: 17px;
  line-height: 1.9;
  overflow-wrap: anywhere;
}

.article-footer {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 35px;
  padding-top: 25px;
  border-top: 1px solid #eee;
}

.article-thumbnail-wrapper {
  width: 100%;
  max-width: 700px;
  margin: 0 auto 25px;
  overflow: hidden;
  border-radius: 16px;
}

.article-thumbnail {
  display: block;
  width: 100%;
  height: auto;
  aspect-ratio: 16 / 9;
  object-fit: contain;
  border-radius: 16px;
}

/* =========================
   POST FORMS + DEVISE
========================= */
.form-page {
  max-width: 760px;
  margin: 42px auto;
  padding: 0 16px;
}

.form-heading { margin-bottom: 30px; text-align: center; }

.form-heading h1 {
  margin: 0 0 10px;
  font-size: 32px;
  font-weight: 700;
}

.form-heading p { color: #777; font-size: 16px; }

.post-form-card {
  max-width: 850px;
  margin: 25px auto;
  padding: 35px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 14px;
  box-shadow: 0 8px 30px rgba(0, 0, 0, .06);
}

.post-form .form-group { margin-bottom: 25px; }

.post-form .form-label {
  display: block;
  margin-bottom: 9px;
  color: var(--ink);
  font-size: 16px;
  font-weight: 700;
}

.form-control,
.post-form .form-control {
  padding: 12px 14px;
  border: 1px solid #dce1e8;
  border-radius: 8px;
}

.post-form .title-input {
  width: 100%;
  height: 50px;
  padding: 12px 15px;
  font-size: 16px;
}

.form-control:focus,
.post-form .title-input:focus {
  border-color: var(--primary);
  outline: none;
  box-shadow: 0 0 0 3px rgba(81, 69, 229, .12);
}

.post-form trix-editor {
  min-height: 300px;
  padding: 18px;
  color: #333;
  background: #fff;
  border: 1px solid #dce1e8;
  border-radius: 8px;
  font-size: 16px;
  line-height: 1.8;
}

.post-form trix-editor:focus {
  border-color: var(--primary);
  outline: none;
  box-shadow: 0 0 0 3px rgba(81, 69, 229, .10);
}

.post-form trix-toolbar { margin-bottom: 10px; }

.post-form .form-actions,
.form-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 28px;
}

.post-form .publish-btn,
.post-form .cancel-btn {
  padding: 11px 25px;
  border-radius: 7px;
  font-weight: 600;
}

.post-form .cancel-btn { border: 1px solid #dce1e8; }

.form-submit-btn {
  width: 100%;
  padding: 12px;
  border-radius: 8px;
  font-weight: 600;
}

.post-form .form-errors {
  margin-bottom: 25px;
  padding: 20px;
  color: #842029;
  background: #fff1f1;
  border: 1px solid #f5c2c7;
  border-radius: 8px;
}

.post-form .form-errors h3 { color: #842029; font-size: 18px; }
.post-form .form-errors li { margin-bottom: 5px; }
.form-footer { max-width: 850px; margin: 22px auto 0; text-align: center; }
.form-footer a { font-weight: 500; text-decoration: none; }
.form-footer a:hover { text-decoration: underline; }
.form-footer .btn { padding: 10px 20px; border-radius: 8px; }
.cancel-account-section { padding-top: 10px; text-align: center; }
.cancel-account-section h5 { margin-bottom: 10px; font-weight: 700; }
.cancel-account-section p { font-size: 14px; }
.cancel-account-section .btn { padding: 10px 20px; border-radius: 8px; font-weight: 600; }
.back-link { color: var(--primary); font-weight: 500; text-decoration: none; }
.back-link:hover { text-decoration: underline; }

/* =========================
   ARTICLE ACTION BUTTONS
========================= */
.article-actions {
  display: flex;
  align-items: center;
  flex-direction: row;
  gap: 10px;
}

.article-actions form {
  display: inline-flex !important;
  flex: 0 0 auto;
  width: auto !important;
  margin: 0 !important;
  padding: 0;
}

.article-actions .btn { margin: 0 !important; white-space: nowrap; }

/* =========================
   BOOTSTRAP CARD COMPATIBILITY
   (e.g. Your Articles page)
========================= */
.card {
  background-color: #fff;
  border: 1px solid #e9e5f5;
  border-radius: 12px;
  padding: 20px;
  margin: 25px auto;
  max-width: 800px;
  box-shadow: 0 4px 15px rgba(0, 0, 0, .08);
  transition: transform .2s ease, box-shadow .2s ease;
}

.card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 25px rgba(0, 0, 0, .12);
}

.card-title {
  margin-bottom: 15px;
  color: var(--ink);
  font-size: 26px;
  font-weight: 700;
}

.card-text { color: #666; font-size: 16px; line-height: 1.7; }

/* =========================
   RESPONSIVE LAYOUT
========================= */
@media (max-width: 991px) {
  .custom-navbar { padding: 12px 22px; }
  .custom-navbar .navbar-nav {
    align-items: flex-start;
    gap: 10px;
    margin-top: 12px;
  }
}

@media (max-width: 768px) {
  .blog-hero-new {
    width: calc(100% - 30px);
    margin: 24px auto 38px;
    padding: 38px 24px;
    border-radius: 20px;
  }

  .blog-hero-new .hero-inner {
    grid-template-columns: 1fr;
    gap: 30px;
    text-align: center;
  }

  .blog-hero-new .hero-visual { min-height: 230px; }

  .blog-hero-new .hero-image-card {
    max-width: 350px;
    height: 215px;
    border-radius: 38px;
  }

  .blog-hero-new .hero-content-new { max-width: 100%; margin: 0 auto; }

  .blog-hero-new .hero-content-new h1 {
    font-size: clamp(36px, 8vw, 46px);
    text-align: center;
    letter-spacing: -1px;
  }

  .blog-hero-new .hero-content-new p {
    margin-right: auto;
    margin-left: auto;
  }

  .blog-hero-new .hero-circle-one { left: 4%; width: 48px; height: 48px; }
  .blog-hero-new .hero-circle-two { width: 34px; height: 34px; }
  .blog-hero-new .hero-circle-three { right: 3%; width: 42px; height: 42px; }

  .homepage-articles { padding: 48px 18px 55px; }

  .homepage-articles .section-heading {
    align-items: flex-start;
    flex-direction: column;
    gap: 16px;
    margin-bottom: 28px;
  }

  .homepage-articles .section-heading h2 { font-size: 29px; }
  .homepage-articles .article-cover { height: 175px; }
  .homepage-articles .post-card-content { padding: 18px; }

  .article-card { padding: 28px 22px; }
  .article-title { font-size: 29px; }
  .article-body { font-size: 16px; }
  .post-form-card { padding: 25px 20px; }
}

@media (max-width: 576px) {
  .form-page { margin: 24px auto; }
  .form-heading h1 { font-size: 27px; }
  .post-form-card { padding: 22px 18px; }
  .post-form trix-editor { min-height: 220px; padding: 12px; }
  .article-page { padding: 24px 14px; }
}


/* FIX: Make Featured Articles Background Full Width */

.homepage-articles {
  width: 100vw !important;
  max-width: 100vw !important;

  margin-left: calc(50% - 50vw) !important;
  margin-right: calc(50% - 50vw) !important;

  border-radius: 0 !important;
}

/* Fix unwanted horizontal scrolling */

html,
body {
  overflow-x: clip;
}

/* ======================================
   DECORATIVE WHITE CAPSULE BACKGROUND
====================================== */

.homepage-articles {
  position: relative;
  overflow: hidden;
}

/* Shape container */
.article-bg-shapes {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

/* White outlined capsule */
.article-bg-shapes .capsule {
  position: absolute;
  display: block;

  width: 260px;
  height: 65px;

  border: 6px solid rgba(255, 255, 255, 0.85);
  border-radius: 999px;

  background: transparent;
}

/* Top-left capsule */
.article-bg-shapes .capsule-one {
  top: 30px;
  left: -90px;
  transform: rotate(25deg);
}

/* Top-right capsule */
.article-bg-shapes .capsule-two {
  top: 100px;
  right: -100px;
  transform: rotate(48deg);
}

/* Bottom-left capsule */
.article-bg-shapes .capsule-three {
  bottom: 100px;
  left: -130px;
  transform: rotate(35deg);
}

/* Bottom-right capsule */
.article-bg-shapes .capsule-four {
  bottom: 35px;
  right: -100px;
  transform: rotate(-30deg);
}

/* Keep article content above the decorations */
.homepage-articles .section-heading,
.homepage-articles > .row,
.homepage-articles > .empty-blog {
  position: relative;
  z-index: 1;
}

/* Smaller capsules on mobile */
@media (max-width: 768px) {
  .article-bg-shapes .capsule {
    width: 170px;
    height: 45px;
    border-width: 4px;
  }
}

/* ==========================================
   NEWSLETTER SUBSCRIBE SECTION
========================================== */
.newsletter-section {
  width: 100%;
  padding: 75px 24px;
  background: #212529;
  overflow: hidden;
}

/* Main White Card */

.newsletter-card {
  position: relative;
  display: flex;
  align-items: center;

  width: 100%;
  max-width: 1100px;
  min-height: 520px;

  margin: 0 auto;
  overflow: hidden;

  background: #ffffff;
  border-radius: 20px;
}

/* Left Decorative Area */

.newsletter-visual {
  position: relative;
  width: 42%;
  min-height: 320px;
  flex-shrink: 0;
}

/* Purple Capsule Shapes */

.newsletter-capsule {
  position: absolute;
  display: block;

  width: 105px;
  height: 42px;

  border: 8px solid #5145e5;
  border-radius: 999px;

  background: transparent;
}

/* Filled capsules */

.newsletter-visual .capsule-a,
.newsletter-visual .capsule-c,
.newsletter-visual .capsule-e {
  background: linear-gradient(
    135deg,
    #5145e5,
    #8955ed
  );

  border: none;
}

/* Individual capsule positions */

.newsletter-visual .capsule-a {
  top: 15px;
  left: 35px;
  width: 105px;
  transform: rotate(28deg);
}

.newsletter-visual .capsule-b {
  top: 45px;
  left: 30px;
  width: 75px;
  height: 38px;
  transform: rotate(18deg);
}

.newsletter-visual .capsule-c {
  top: 35px;
  right: 30px;
  width: 85px;
  height: 42px;
  transform: rotate(-42deg);
}

.newsletter-visual .capsule-d {
  top: 125px;
  left: 100px;
  width: 105px;
  height: 42px;
  transform: rotate(38deg);
}

.newsletter-visual .capsule-e {
  bottom: 30px;
  left: 40px;
  width: 70px;
  height: 35px;
  transform: rotate(12deg);
}

.newsletter-visual .capsule-f {
  bottom: -30px;
  left: -25px;
  width: 95px;
  height: 95px;
  border-width: 12px;
}

/* Right Content Area */

.newsletter-content {
  position: relative;
  z-index: 1;

  flex: 1;
  min-width: 0;

  padding: 40px 55px 40px 15px;
}

.newsletter-content h2 {
  margin: 0 0 12px;

  color: #292936;
  font-size: 32px;
  font-weight: 800;
}

.newsletter-content p {
  max-width: 440px;
  margin: 0 0 25px;

  color: #666675;
  font-size: 15px;
  line-height: 1.7;
}

/* Subscribe Form */

.newsletter-form {
  display: flex;
  width: 100%;
  max-width: 480px;

  overflow: hidden;

  border: 1px solid #5145e5;
  border-radius: 8px;
  background: #ffffff;
}

.newsletter-form input {
  flex: 1;
  min-width: 0;

  padding: 14px 16px;

  border: none;
  outline: none;

  color: #292936;
  font-size: 13px;
}

.newsletter-form input::placeholder {
  color: #888895;
}

.newsletter-form button {
  padding: 0 22px;

  border: none;
  background: #5145e5;
  color: #ffffff;

  font-size: 11px;
  font-weight: 700;

  cursor: pointer;
  transition: background 0.2s ease;
}

.newsletter-form button:hover {
  background: #4035c9;
}

/* Mobile Responsive */

@media (max-width: 768px) {

  .newsletter-section {
    padding: 45px 18px;
  }

  .newsletter-card {
    flex-direction: column;
  }

  .newsletter-visual {
    width: 100%;
    min-height: 150px;
  }

  .newsletter-content {
    width: 100%;
    padding: 20px 25px 35px;
  }

  .newsletter-content h2 {
    font-size: 28px;
  }

  .newsletter-form button {
    padding: 0 14px;
  }

}

/* ===================================
   NEWSLETTER SECTION — LAYOUT FIX
=================================== */

.newsletter-section {
  width: 100vw;
  max-width: 100vw;

  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);

  padding: 60px 24px;
 background: #eef0ff;

  overflow: hidden;
  box-sizing: border-box;
}

/* White Subscribe Panel */

.newsletter-card {
  width: 100%;
  max-width: 1100px;

  min-height: 380px;
  margin: 0 auto;

  border-radius: 20px;
}

/* Keep decorative area the same height */

.newsletter-visual {
  min-height: 520px;
}

/* Keep the content centered vertically */

.newsletter-content {
  align-self: center;
}

/* Prevent horizontal scrolling */

html,
body {
  overflow-x: clip;
}


/* =========================================
   ARTICLES INDEX PAGE
========================================= */

.articles-index-page {
  min-height: 100vh;
  padding: 45px 24px 80px;
  background: #f0f1f5;
  color: #252638;
}

.articles-layout {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(240px, 0.9fr);
  gap: 28px;

  max-width: 1180px;
  margin: 0 auto;
  align-items: start;
}

/* =========================================
   MAIN CONTENT
========================================= */

.articles-main {
  min-width: 0;
}

.articles-page-heading {
  margin-bottom: 20px;
}

.articles-page-heading h1 {
  margin: 0 0 8px;

  color: #5145e5;
  font-size: 36px;
  font-weight: 800;
}

.articles-page-heading p {
  margin: 0;
  color: #77798b;
  font-size: 14px;
}

/* Search */

.articles-search {
  display: flex;
  align-items: center;
  gap: 10px;

  padding: 10px 14px;
  margin-bottom: 18px;

  background: #ffffff;
  border: 1px solid #e5e6ef;
  border-radius: 9px;
}

.articles-search span {
  color: #77798b;
  font-size: 20px;
}

.articles-search input {
  width: 100%;
  border: none;
  outline: none;
  background: transparent;

  color: #77798b;
  font-size: 13px;
}

/* Categories */

.article-categories {
  display: flex;
  align-items: center;
  gap: 24px;

  padding: 0 4px 14px;
  margin-bottom: 8px;

  overflow-x: auto;
  white-space: nowrap;

  color: #77798b;
  font-size: 12px;
}

.article-categories span {
  cursor: default;
}

.article-categories .category-active {
  color: #5145e5;
  font-weight: 700;

  border-bottom: 2px solid #5145e5;
  padding-bottom: 8px;
}

/* =========================================
   ARTICLE FEED CARD
========================================= */

.articles-feed {
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.feed-article-card {
  display: flex;
  gap: 18px;

  min-width: 0;
  padding: 14px;

  background: #ffffff;
  border: 1px solid #e7e8f0;
  border-radius: 12px;

  box-shadow: 0 4px 15px rgba(25, 30, 70, 0.035);

  transition: transform 0.2s ease,
              box-shadow 0.2s ease;
}

.feed-article-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 22px rgba(25, 30, 70, 0.08);
}

/* Thumbnail */

.feed-article-image {
  width: 150px;
  min-width: 150px;
  height: 125px;

  overflow: hidden;
  border-radius: 8px;
  background: #e9eaff;
}

.feed-article-image img {
  display: block;

  width: 100%;
  height: 100%;

  object-fit: cover;
}

.feed-image-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 100%;
  height: 100%;

  font-size: 32px;
  background: linear-gradient(135deg, #e9eaff, #dfe6ff);
}

/* Article Text */

.feed-article-content {
  display: flex;
  flex-direction: column;

  flex: 1;
  min-width: 0;
}

.feed-article-top {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 7px;
}

.feed-category {
  padding: 4px 9px;

  color: #5145e5;
  background: #f0edff;
  border-radius: 5px;

  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.4px;
}

.feed-date {
  color: #999bad;
  font-size: 11px;
}

.feed-article-content h2 {
  margin: 0 0 7px;

  font-size: 17px;
  font-weight: 700;
  line-height: 1.35;
}

.feed-article-content h2 a {
  color: #292b3b;
  text-decoration: none;
}

.feed-article-content h2 a:hover {
  color: #5145e5;
}

.feed-article-excerpt {
  margin: 0 0 12px;

  color: #77798b;
  font-size: 12px;
  line-height: 1.6;
}

/* Card Footer */

.feed-article-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;

  margin-top: auto;
  padding-top: 10px;

  border-top: 1px solid #f0f0f5;
}

.feed-read-label {
  color: #999bad;
  font-size: 11px;
}

.feed-read-button {
  display: inline-block;

  padding: 7px 12px;

  color: #ffffff !important;
  background: #5145e5;

  border-radius: 6px;
  text-decoration: none !important;

  font-size: 11px;
  font-weight: 600;

  transition: background 0.2s ease;
}

.feed-read-button:hover {
  background: #4035c9;
}

/* Empty State */

.articles-empty-state {
  padding: 45px 20px;

  text-align: center;
  background: #ffffff;
  border-radius: 12px;
}

.articles-empty-state h3 {
  font-size: 22px;
  font-weight: 700;
}

.articles-empty-state p {
  color: #77798b;
  font-size: 14px;
}

/* =========================================
   RIGHT SIDEBAR
========================================= */

.articles-sidebar {
  display: flex;
  flex-direction: column;
  gap: 20px;

  min-width: 0;
  padding-top: 65px;
}

.sidebar-box {
  padding: 18px;

  background: #ffffff;
  border: 1px solid #e7e8f0;
  border-radius: 12px;

  box-shadow: 0 4px 15px rgba(25, 30, 70, 0.035);
}

.sidebar-box h3 {
  margin: 0 0 16px;

  color: #292b3b;
  font-size: 16px;
  font-weight: 700;
}

/* Trending */

.trending-article {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 14px;
}

.trending-article:last-child {
  margin-bottom: 0;
}

.trending-image {
  display: flex;
  align-items: center;
  justify-content: center;

  width: 48px;
  min-width: 48px;
  height: 48px;

  overflow: hidden;
  border-radius: 7px;
  background: #e9eaff;
}

.trending-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.trending-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.trending-info a {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;

  color: #35364a;
  text-decoration: none;

  font-size: 12px;
  font-weight: 600;
  line-height: 1.4;
}

.trending-info a:hover {
  color: #5145e5;
}

.trending-info small {
  margin-top: 5px;
  color: #999bad;
  font-size: 10px;
}

.sidebar-empty {
  color: #77798b;
  font-size: 12px;
}

/* Explore Box */

.recommended-box p {
  color: #77798b;
  font-size: 13px;
  line-height: 1.6;
}

.sidebar-explore-link,
.sidebar-create-link {
  display: block;
  margin-top: 12px;

  color: #5145e5;
  text-decoration: none;

  font-size: 12px;
  font-weight: 700;
}

.sidebar-explore-link:hover,
.sidebar-create-link:hover {
  color: #4035c9;
  text-decoration: none;
}

/* =========================================
   RESPONSIVE DESIGN
========================================= */

@media (max-width: 900px) {

  .articles-layout {
    grid-template-columns: minmax(0, 1fr);
  }

  .articles-sidebar {
    padding-top: 0;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

}

@media (max-width: 600px) {

  .articles-index-page {
    padding: 30px 14px 50px;
  }

  .feed-article-card {
    gap: 12px;
    padding: 10px;
  }

  .feed-article-image {
    width: 95px;
    min-width: 95px;
    height: 105px;
  }

  .feed-article-content h2 {
    font-size: 14px;
  }

  .feed-article-excerpt {
    font-size: 11px;
  }

  .feed-read-label {
    display: none;
  }

  .articles-sidebar {
    grid-template-columns: minmax(0, 1fr);
  }

}.articles-index-page {
  position: relative;
  isolation: isolate;

  min-height: 100vh;
  padding: 45px 24px 80px;

  background: linear-gradient(
    135deg,
    #eef0ff 0%,
    #e8eaff 50%,
    #f3edff 100%
  );

  color: #252638;
  overflow: hidden;
}


/* ==========================================
   ARTICLES PAGE — CLEAN BACKGROUND CAPSULES
========================================== */

.articles-index-page {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}

/* Decorative shapes stay behind the content */
.articles-bg-shapes {
  position: absolute;
  inset: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

/* Capsule design */
.articles-capsule {
  position: absolute;
  display: block;

  width: 145px;
  height: 43px;

  border: 6px solid rgba(255, 255, 255, 0.9);
  border-radius: 999px;

  background: transparent;
  opacity: 0.85;
}

/* Top-left — mostly outside the page */
.articles-capsule-one {
  top: 55px;
  left: -125px;
  transform: rotate(35deg);
}

/* Top-right — outside the content */
.articles-capsule-two {
  top: 170px;
  right: -125px;
  transform: rotate(-35deg);
}

/* Left side — lower down */
.articles-capsule-three {
  top: 520px;
  left: -130px;
  transform: rotate(50deg);
}

/* Right side — lower down */
.articles-capsule-four {
  top: 780px;
  right: -130px;
  transform: rotate(-40deg);
}

/* Bottom-left */
.articles-capsule-five {
  top: 1100px;
  left: -125px;
  transform: rotate(-35deg);
}

/* Bottom-right */
.articles-capsule-six {
  top: 1350px;
  right: -125px;
  transform: rotate(40deg);
}

/* Keep all article content above decorations */
.articles-layout {
  position: relative;
  z-index: 1;
}

/* Smaller capsules on phones */
@media (max-width: 768px) {
  .articles-capsule {
    width: 100px;
    height: 32px;
    border-width: 4px;
  }
}
/* ==========================================
   ARTICLES SEARCH — FUNCTIONAL FORM
========================================== */

.articles-search {
  display: flex;
  align-items: center;
  gap: 10px;

  padding: 6px 8px 6px 14px;

  background: #ffffff;
  border: 1px solid #dedfff;
  border-radius: 10px;

  box-shadow: 0 4px 14px rgba(50, 45, 130, 0.04);
}

.articles-search input[type="search"] {
  flex: 1;
  width: 100%;
  min-width: 0;

  padding: 9px 4px;

  border: none;
  outline: none;
  background: transparent;

  color: #292b3b;
  font-size: 13px;
}

.article-search-button {
  padding: 10px 17px;

  border: none;
  border-radius: 7px;

  background: #5145e5;
  color: #ffffff;

  font-size: 12px;
  font-weight: 600;

  cursor: pointer;
  transition: background 0.2s ease;
}

.article-search-button:hover {
  background: #4035c9;
}

.search-results-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;

  margin: 12px 0 18px;

  color: #77798b;
  font-size: 13px;
}

.search-results-info p {
  margin: 0;
}

.search-results-info strong {
  color: #5145e5;
}

.search-results-info a {
  color: #5145e5;
  font-weight: 600;
  text-decoration: none;
}